# 复制此文件为 .env 并填入真实值。.env 已被 .gitignore 忽略，不会入库。

# ---- 必填 ----
DEEPSEEK_API_KEY=sk-your-key-here

# ---- 可选（留空则使用代码内默认值）----
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Agent 行为
CRA_MAX_STEPS=8
CRA_MAX_FILE_BYTES=204800
CRA_MAX_CONTEXT_CHARS=120000
CRA_THINKING=disabled

# 终端兼容：CMD 出现乱码时设为 1 切换到纯 ASCII 输出
CRA_ASCII=0
